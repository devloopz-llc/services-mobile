<?xml version="1.0" encoding="utf-8"?>
<!-- Local dev only: allows plain HTTP to the emulator's host-loopback
     alias for `php artisan serve`. Remove once the API has a real
     HTTPS host. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
